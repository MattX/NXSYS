;; Trains at Islington: two trains follow each other through a route; the second brakes for the
;; signals dropped behind the first and runs when they are cleared again.
;; Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Islington/islingtn.trk")
(say 2000 "islington: throw two switches by hand....")
(mouseright switch 13 "")
(mouseright switch 15 "")
(say 6000 "Wait for the switches...")
(say 1000 "Route: entrance 50, exit 10")
(signal 50 "")
(wait 500)
(signal 10 "")
(wait 9000)
(say 1000 "Train 1 enters")
(train 1 create 2137)
(wait 12000)
(say 1000 "Train 2 follows")
(train 2 create 2137 hidedialog)
(wait 40000)
(say 1000 "Train 1 has stopped at the red signal at the end of the route; remove it")
(train 1 kill)
(wait 12000)
(say 1000 "Clear the route again for train 2")
(signal 50 "")
(wait 500)
(signal 10 "")
(wait 80000)
(say 1000 "Done.")
