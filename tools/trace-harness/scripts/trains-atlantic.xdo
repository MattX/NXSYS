;; Trains at Atlantic Ave.: a train runs down an automatic-signal approach, brakes for the red
;; home signal 212 and proceeds when the route is lined; a second train is hand-driven past a
;; signal and tripped; a bad TRAIN command ends the demo. Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Atlantic/atlantic.trk")
(say 2000 "atlantic: throw two switches by hand....")
(mouseright switch 205 "")
(mouseright switch 207 "")
(say 6000 "Wait for the switches...")
(say 1000 "Train 1 enters at the east end of track 4 and runs up on the red home signal 212")
(train 1 create 1724)
(wait 45000)
(say 1000 "Route: entrance 212, exit 222")
(signal 212 "")
(wait 500)
(signal 222 "")
(wait 12000)
(say 1000 "Train 2 is hand-driven down track 3 and runs the red signal 216")
(train 2 create 1762 halted hidedialog)
(train 2 freewill)
(train 2 speed 50)
(wait 100000)
(say 1000 "There is no train 9; the demo stops with an error")
(train 9 halt)
(say 1000 "Done.")
