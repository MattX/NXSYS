;; Trains at Duckburg: a train created at the Mickey end is routed through two routes in turn,
;; speed-restricted on the way, then runs on the second route to the end of the line.
;; Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Duckburg/db7.trk")
(say 2000 "duckburg: throw two switches by hand....")
(mouseright switch 3 "")
(mouseright switch 5 "")
(say 6000 "Wait for the switches...")
(say 1000 "Train 1 enters")
(train 1 create 3730)
(wait 2000)
(train 1 minimize)
(wait 1000)
(train 1 restore)
(wait 1000)
(train 1 restore)
(say 1000 "Route 1: entrance 32, exit 54")
(signal 32 "")
(wait 500)
(signal 54 "")
(wait 60000)
(say 1000 "Route 2: entrance 30, exit 48")
(signal 30 "")
(wait 500)
(signal 48 "")
(wait 60000)
(say 1000 "Done.")
