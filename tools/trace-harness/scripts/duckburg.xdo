;; Demo script for the trace harness: throw two switches by hand, then set routes.
;; Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Duckburg/db7.trk")
(say 2000 "duckburg: throw two switches by hand....")
(mouseright switch 3 "")
(mouseright switch 5 "")
(say 6000 "Wait for the switches...")
(say 1000 "Route 1: entrance 32, exit 54")
(signal 32 "")
(wait 500)
(signal 54 "")
(wait 14000)
(say 1000 "Route 2: entrance 30, exit 48")
(signal 30 "")
(wait 500)
(signal 48 "")
(wait 14000)
(say 2000 "Done.")
