;; Demo script for the trace harness: throw two switches by hand, then set routes.
;; Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Myrtle/myrtle.trk")
(say 2000 "myrtle: throw two switches by hand....")
(mouseright switch 155 "")
(mouseright switch 165 "")
(say 6000 "Wait for the switches...")
(say 1000 "Route 1: entrance 160, exit 168")
(signal 160 "")
(wait 500)
(signal 168 "")
(wait 14000)
(say 1000 "Route 2: entrance 166, exit 170")
(signal 166 "")
(wait 500)
(signal 170 "")
(wait 14000)
(say 2000 "Done.")
