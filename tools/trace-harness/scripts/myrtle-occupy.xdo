;; Demo script for the trace harness: set a route, then occupy and vacate track sections
;; (occupied-track drawing, signals dropping, stops, fleeting). Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Myrtle/myrtle.trk")
(say 2000 "myrtle: throw a switch by hand....")
(mouseright switch 155 "")
(say 4000 "Wait for the switch...")
(say 1000 "Route 1: entrance 160, exit 168")
(signal 160 "")
(wait 500)
(signal 168 "")
(wait 9000)
(say 1000 "Occupy a track section in the route")
(track 2234 "")
(wait 6000)
(track 2236 "")
(wait 6000)
(say 1000 "Vacate")
(track 2234 "")
(wait 3000)
(track 2236 "")
(wait 6000)
(say 1000 "Fleet a signal")
(mouseleftshift signal 166 "")
(wait 8000)
(say 2000 "Done.")
