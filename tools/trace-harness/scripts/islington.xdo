;; Demo script for the trace harness: throw two switches by hand, then set routes.
;; Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Islington/islingtn.trk")
(say 2000 "islington: throw two switches by hand....")
(mouseright switch 13 "")
(mouseright switch 15 "")
(say 6000 "Wait for the switches...")
(say 1000 "Route 1: entrance 50, exit 10")
(signal 50 "")
(wait 500)
(signal 10 "")
(wait 14000)
(say 1000 "Route 2: entrance 30, exit 12")
(signal 30 "")
(wait 500)
(signal 12 "")
(wait 14000)
(say 2000 "Done.")
