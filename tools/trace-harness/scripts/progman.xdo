;; Demo script for the trace harness: throw two switches by hand, then set routes.
;; Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Progman/progman.trk")
(say 2000 "progman: throw two switches by hand....")
(mouseright switch 9 "")
(mouseright switch 17 "")
(say 6000 "Wait for the switches...")
(say 1000 "Route 1: entrance 4, exit 20")
(signal 4 "")
(wait 500)
(signal 20 "")
(wait 14000)
(say 1000 "Route 2: entrance 16, exit 32")
(signal 16 "")
(wait 500)
(signal 32 "")
(wait 14000)
(say 2000 "Done.")
