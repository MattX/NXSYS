;; Demo script for the trace harness: throw two switches by hand, then set routes.
;; Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Atlantic/atlantic.trk")
(say 2000 "atlantic: throw two switches by hand....")
(mouseright switch 205 "")
(mouseright switch 207 "")
(say 6000 "Wait for the switches...")
(say 1000 "Route 1: entrance 244, exit 222")
(signal 244 "")
(wait 500)
(signal 222 "")
(wait 14000)
(say 1000 "Route 2: entrance 206, exit 212")
(signal 206 "")
(wait 500)
(signal 212 "")
(wait 14000)
(say 2000 "Done.")
