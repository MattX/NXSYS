;; Trains at Myrtle Ave.: a train created at the 8248 end brakes for a red signal, proceeds as the
;; signals are cleared, is halted, reversed and sent back, and a call-on is requested for it.
;; Paths are relative to this file.
(clicktime 200 200)
(load "../../../Interlockings/Myrtle/myrtle.trk")
(say 2000 "myrtle: throw two switches by hand....")
(mouseright switch 155 "")
(mouseright switch 165 "")
(say 6000 "Wait for the switches...")
(say 1000 "Train 1 arrives at the 8th Ave end and brakes for the red signal")
(train 1 create 8248)
(wait 8000)
(say 1000 "Ask for a call-on at signal 168, then clear it properly, and route 166 to exit 170")
(train 1 callon)
(wait 3000)
(signal 168 "")
(wait 6000)
(signal 166 "")
(wait 500)
(signal 170 "")
(wait 12000)
(say 1000 "Halt the train, turn it around, and send it back; check it still works")
(train 1 halt)
(wait 3000)
(train 1 reverse)
(wait 1000)
(train 1 callon)
(train 1 observant)
(train 1 speed 40)
(wait 60000)
(say 1000 "Done.")
